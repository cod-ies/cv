# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://lohn:lohn@localhost:5432/lohnabrechnung

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# ShiftPilot API
SHIFTPILOT_BASE_URL=https://api.shiftpilot.app/v1
SHIFTPILOT_API_KEY=your_shiftpilot_api_key_here

# ERiC / ELSTER Certificate
ERIC_CERT_PATH=/run/secrets/elster.pfx
ERIC_CERT_PASSWORD=your_cert_password_here
ERIC_LOG_PATH=/var/log/eric
# 'test' or 'production'
ERIC_ENV=test

# ELStAM / ELSTER endpoints
# Set by ERIC_ENV; override only if needed
ELSTAM_BASE_URL=https://www.elster.de/eportal/

# Payroll company (Arbeitgeber)
COMPANY_STEUERNUMMER=12/345/67890
COMPANY_BUNDESLAND=NW
COMPANY_NAME=Muster GmbH

# S3 / MinIO for payslip PDFs
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=payslips
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
